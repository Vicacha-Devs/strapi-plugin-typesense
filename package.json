    "react-intl": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "styled-components": "^6.4.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@strapi/typescript-utils": "^5.51.1",
    "typescript": "^5.9.3"
